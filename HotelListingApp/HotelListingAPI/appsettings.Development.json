{
  // Serilog
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      },
      // Seq logger
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "HotelListingAPI"
    }
  },
  "ConnectionStrings": {
    "MSSQLConnection": "Server=TareqPC\\MSSQLSRV; Database=HotelsListingDB; Trusted_Connection=True; TrustServerCertificate=True;"
  },
  // Api Key Authentication
  "ApiKey": "dXNlcjFAbG9jYWxob3N0LmNvbTpQQHNzd29yZDE=",

  // JWT Token
  "JwtSettings": {
    "Issuer": "HotelListingAPI",
    "Audience": "HotelListingAPIClient",
    "DurationInMinutes": "10",
    "Key": "G+aEs9?dkfvtS4RnOBs#AdX3J1Ua_<;k"
  }
}
